{
    "projectId": "6ad5903b00090bd47e4e",
    "projectName": "Bloom",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": false,
                "anonymous": false,
                "email-otp": false,
                "magic-url": false,
                "email-password": true
            },
            "security": {
                "usersessions": 10,
                "sessionalerts": true,
                "passworddictionary": true,
                "passwordhistory": 0,
                "passwordsessions": false,
                "personaldata": false,
                "sessionlength": 2592000,
                "duration": 2592000
            }
        }
    },
    "functions": [
        {
            "$id": "phone-login",
            "name": "phone-login",
            "runtime": "dart-3.5",
            "specification": "s-0.5vcpu-512mb",
            "execute": [
                "any"
            ],
            "scopes": [
                "users.read",
                "users.write",
                "rows.read",
                "rows.write"
            ],
            "events": [],
            "schedule": "",
            "timeout": 15,
            "enabled": true,
            "logging": false,
            "entrypoint": "lib/main.dart",
            "commands": "dart pub get",
            "path": "functions/phone-login",
            "vars": []
        },
        {
            "$id": "payments",
            "name": "payments",
            "runtime": "dart-3.5",
            "specification": "s-0.5vcpu-512mb",
            "execute": [
                "users"
            ],
            "scopes": [
                "rows.read",
                "rows.write",
                "users.read",
                "users.write"
            ],
            "events": [],
            "schedule": "*/15 * * * *",
            "timeout": 30,
            "enabled": true,
            "logging": false,
            "entrypoint": "lib/main.dart",
            "commands": "dart pub get",
            "path": "functions/payments",
            "vars": [
                {
                    "key": "BLOOMLY_UPI_ID",
                    "value": "9060344838@ptyes"
                },
                {
                    "key": "BLOOMLY_UPI_NAME",
                    "value": "Bloom"
                }
            ]
        }
    ],
    "buckets": [
        {
            "$id": "promo-media",
            "name": "Promo media",
            "enabled": true,
            "fileSecurity": false,
            "maximumFileSize": 5000000,
            "allowedFileExtensions": ["mp4", "webm", "json", "jpg", "jpeg", "png", "webp"],
            "compression": "none",
            "encryption": false,
            "antivirus": false,
            "$permissions": [
                "read(\"any\")",
                "create(\"users\")",
                "update(\"users\")",
                "delete(\"users\")"
            ]
        }
    ]
}