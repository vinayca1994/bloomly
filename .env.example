# Copy to .env for the seed script. Do not commit .env.
# The Flutter app reads APPWRITE_ENDPOINT, APPWRITE_PROJECT_ID,
# BLOOMLY_UPI_ID, and BLOOMLY_UPI_NAME with --dart-define.
# Never pass APPWRITE_API_KEY into the app.

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Optional owner created by tool/seed.dart
APPWRITE_OWNER_EMAIL=owner@bloomly.app
APPWRITE_OWNER_PASSWORD=

# Store UPI ID, such as bloomly@oksbi. Leave blank to use the in-app demo,
# which does not charge a bank. The ID is public: it is shown in the QR.
BLOOMLY_UPI_ID=
BLOOMLY_UPI_NAME=Bloomly
