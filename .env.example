# Copy to .env for the seed script and scripts/run_appwrite.sh. Do not commit .env.
# For IDE launches, keep the same public values in dart_defines.json
# (endpoint, project id, optional UPI). Never put APPWRITE_API_KEY there
# or in --dart-define-from-file.

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Owner created by tool/seed.dart. Password is required and must be 12+ characters.
# Do not commit the real password.
APPWRITE_OWNER_EMAIL=
APPWRITE_OWNER_PASSWORD=

# Store UPI ID, such as shop@oksbi. Leave blank to use the in-app demo,
# which does not charge a bank. The ID is public: it is shown in the QR.
BLOOMLY_UPI_ID=9060344838@ptyes
BLOOMLY_UPI_NAME=Bloom

# Vi DLT portal. Bloom does not call this URL. SMS OTP is sent by Appwrite
# after an SMS provider (MSG91) is set in the Appwrite console.
# https://connect.vilpower.in
#
# WhatsApp login is sent by the phone-login function. Set these on that
# function in the Appwrite console. Do not put them in this file,
# dart_defines.json, or the Flutter app:
# OTP_PEPPER, MSG91_AUTH_KEY. MSG91_WHATSAPP_TEMPLATE is optional and
# defaults to loomWhatsAppOTP (6 digits, 30-second resend, 15 minutes).
#
# Razorpay. Put the real values in .env and on the payments function.
# Never put the key secret or webhook secret in dart_defines.json or the app.
# Leave the key id blank to keep the in-memory demo, which does not charge a bank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
